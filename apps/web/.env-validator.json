{
  "version": 1,
  "targets": [
    {
      "name": "legacy-debian-dev-web",
      "env_files": [".env"],
      "required": ["DATABASE_URL", "JWT_SECRET", "LLM_ENCRYPTION_KEY"]
    }
  ],
  "classifications": {
    "optional": [
      "CLOUDFLARE_RUNTIME_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_AI_API_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ],
    "ui_managed": ["LLM_PROVIDER_API_KEY", "VECTORIZE_API_TOKEN"],
    "machine_local": ["HYPERFRAMES_RENDERER_PATH", "FFMPEG_PATH"],
    "defaulted": ["MARKETPLACE_EXTENSION_TOKEN_TTL_HOURS"]
  }
}
