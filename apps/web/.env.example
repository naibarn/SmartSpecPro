# SmartAIHub Web - Example environment
NODE_ENV=development
PORT=3000

# Public URL - Required for external services (like KIE AI) to access uploaded files
# Set this to your tenant's public domain (e.g., https://smartaihub.app)
PUBLIC_URL=https://your-domain.com

# Desktop packaged builds use this public URL when running inside Tauri.
# End users should connect through your public HTTPS domain, not localhost:8000.
VITE_SMARTAIHUB_WEB_URL=https://your-domain.com
# Backwards compatibility for older builds.
VITE_SMARTSPEC_WEB_URL=https://your-domain.com

# Database (PostgreSQL) - matches docker-compose.yml settings
DATABASE_URL=postgresql://smartspec:smartspec123@localhost:5432/smartspec

# Internal Python backend URL used by the web server itself.
# This is typically private/reverse-proxied and should not be exposed directly to desktop users.
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Session auth
JWT_SECRET=change_me_to_a_long_random_secret
VITE_APP_ID=smartspecweb
OWNER_OPEN_ID=

# LLM Provider API Key Encryption (32+ character random string)
# IMPORTANT: If you change this key, all encrypted API keys & passwords must be re-saved
LLM_ENCRYPTION_KEY=change_me_to_32_char_random_string

# Bearer token auth for non-browser callers (LLM proxy -> website gateway / MCP)
SMARTSPEC_WEB_GATEWAY_TOKEN=replace_me_gateway_token
SMARTSPEC_MCP_TOKEN=replace_me_mcp_token

# Desktop release configuration is now managed in the UI:
# Admin → Desktop Host → Desktop Release Settings.
# These legacy environment variables are kept only for backward compatibility.
SMARTAIHUB_DESKTOP_RELEASE_UPLOAD_TOKEN=
SMARTAIHUB_DESKTOP_RELEASE_GITHUB_TOKEN=
DESKTOP_RELEASE_GITHUB_REPOSITORY=
DESKTOP_RELEASE_GITHUB_WORKFLOW=
DESKTOP_RELEASE_GITHUB_REF=
SMARTAIHUB_DESKTOP_PUBLIC_URL=

# Rate limits (in-memory). For multi-instance, enforce at gateway/redis.
WEB_LLM_RPM=120
WEB_LLM_MAX_BODY_BYTES=2097152
WEB_MCP_RPM=240

# Credit system configuration
WEB_LLM_MIN_CREDITS=1                    # Minimum credits required to make LLM request
WEB_LLM_CREDIT_PER_1K_TOKENS=0.1         # Credits charged per 1000 tokens
WEB_LLM_SKIP_CREDIT_FOR_STATIC=false     # Skip credit check for static tokens (server-to-server)

# Workspace tools
WORKSPACE_ROOT=./workspace
MCP_EXT_ALLOWLIST=.md,.txt,.json,.yaml,.yml,.ts,.tsx,.js,.py,.css,.html
MCP_MAX_READ_BYTES=1048576
MCP_MAX_WRITE_BYTES=1048576
MCP_REQUIRE_WRITE_TOKEN=1
MCP_WRITE_TOKEN=replace_me_write_token

# PostHog Analytics (optional - write-only key, safe for client bundles)
# VITE_POSTHOG_API_KEY=phc_your_key_here
# POSTHOG_API_KEY=phc_your_server_key_here

# S3/R2 Storage (optional)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=

# Stripe (for credit purchases)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# =============================================================================
# OPENSANDBOX INTEGRATION
# =============================================================================
# Master switch for sandbox execution. When false, all workloads use legacy paths.
OPENSANDBOX_ENABLED=false

# Dispatch mode: 'optional' allows legacy fallback, 'required' fails if sandbox unavailable.
OPENSANDBOX_DISPATCH_MODE=optional

# Default sandbox profile slug (must match a row in sandbox_profiles table).
SANDBOX_DEFAULT_PROFILE=code-default

# Per-feature enforcement flags. When true, the feature MUST use sandbox (no legacy fallback).
SANDBOX_REQUIRE_FOR_SKILLS=false
SANDBOX_REQUIRE_FOR_MEDIA=false

AGENCY_SWARM_ENABLED=true

# =============================================================================
# GLITCHTIP (Self-hosted error tracking — replaces Sentry)
# =============================================================================
# Run ./scripts/setup-glitchtip.sh to generate .env.glitchtip automatically.
# The SECRET_KEY goes in .env.glitchtip, NOT here — it's container-specific.
# After setup, enter the DSN in Admin → Infrastructure → Monitoring.
# Access: https://glitchtip.smartaihub.app
# Frontend Sentry
# Browser Sentry is disabled automatically on localhost/development unless you
# explicitly opt in with VITE_SENTRY_ALLOW_DEV=true.
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ALLOW_DEV=false
VITE_SENTRY_SAMPLE_RATE=0.2
VITE_SENTRY_TRACES_SAMPLE_RATE=0.02
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0.1
SMARTSPEC_PLAYWRIGHT_ENABLED=false
