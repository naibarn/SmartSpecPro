  "scripts": {
    "dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null; NODE_ENV=development NODE_OPTIONS='--max-old-space-size=4096' tsx watch server/_core/index.ts",
    "dev:tsx": "lsof -ti:3000 | xargs kill -9 2>/dev/null; NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:no-watch": "lsof -ti:3000 | xargs kill -9 2>/dev/null; NODE_ENV=development node --import tsx server/_core/index.ts",
    "build": "vite build && npm run build:widget",
    "build:widget": "vite build --config vite.config.widget.ts",
    "start": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=8192' tsx server/_core/index.ts",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "JWT_SECRET=test-jwt-secret-32-chars-minimum-1234567890 vitest run",
    "e2e:production-director": "JWT_SECRET=test-jwt-secret-32-chars-minimum-1234567890 vitest run client/src/features/media-production/production-director.e2e.test.tsx",
    "e2e:production-director-browser": "playwright test tests/e2e/production-director-browser.spec.ts --project=chromium",
    "e2e:marketplace-hyperframes": "playwright test tests/e2e/marketplace-hyperframes-ui.spec.ts --project=chromium",
    "hyperframes:dependency-audit": "node scripts/hyperframes-dependency-audit.mjs",
    "hyperframes:doctor": "node scripts/hyperframes-doctor.mjs",
    "hyperframes:fixture-render": "node scripts/hyperframes-fixture-render.mjs",
    "hyperframes:snapshot-test": "node scripts/hyperframes-snapshot-test.mjs",
    "hyperframes:production-rollout-gate": "node scripts/hyperframes-production-rollout-gate.mjs",
    "test:coverage": "JWT_SECRET=test-jwt-secret-32-chars-minimum-1234567890 vitest run --coverage",
    "test:workos-teams-regression": "JWT_SECRET=test-jwt-secret-32-chars-minimum-1234567890 vitest run client/src/pages/__tests__/Teams.planVisibility.test.tsx client/src/pages/__tests__/AdminWorkOsDashboard.bridge.test.tsx client/src/pages/__tests__/WorkStatusBridge.chain.test.tsx server/services/__tests__/workStatusBridge.test.ts server/services/__tests__/workOsService.test.ts server/services/__tests__/monitoringService.test.ts",
    "test:db-integration": "JWT_SECRET=test-jwt-secret-32-chars-minimum-1234567890 DATABASE_URL=${DATABASE_URL:-postgresql://smartspec:smartspec123@localhost:5432/smartspec_test} RUN_DB_INTEGRATION_TESTS=true vitest run server/routers/adminTenants.integration.test.ts",
    "i18n:translate": "node scripts/i18n-auto-translate.mjs",
    "i18n:translate:dry": "node scripts/i18n-auto-translate.mjs --dry-run",
    "i18n:scan": "node scripts/i18n-inject-t.mjs --path client/src/pages --report",
    "i18n:scan:components": "node scripts/i18n-inject-t.mjs --path client/src/components --report",
    "i18n:coverage": "node -e \"const fs=require('fs');const e=fs.readdirSync('client/src/locales/en/').filter(f=>f.endsWith('.json'));let t=0,d=0;e.forEach(f=>{const en=JSON.parse(fs.readFileSync('client/src/locales/en/'+f,'utf8'));const th=JSON.parse(fs.readFileSync('client/src/locales/th/'+f,'utf8'));const el=Object.keys(en).length;const tl=Object.keys(th).length;t+=el;d+=tl;const p=el>0?Math.round(tl/el*100):0;const b=p>=90?'✅':p>=50?'🟡':p>0?'🔴':'⬜';console.log(b+' '+f.replace('.json','').padEnd(16)+' EN:'+String(el).padStart(3)+' TH:'+String(tl).padStart(3)+' ('+p+'%)')});console.log('TOTAL: '+Math.round(d/t*100)+'% ('+d+'/'+t+')')\"",
    "report:presentation-release-gate": "tsx scripts/generate-presentation-release-gate-report.ts",
    "seed:media:providers": "tsx scripts/seed-media-providers.ts",
    "seed:media:uvoice": "tsx scripts/seed-media-models-uvoice.ts",
    "seed:media:wavespeed": "tsx scripts/seed-media-models-wavespeed.ts",
    "seed:smartaihub:public": "tsx scripts/seed-smartaihub-public-pages.ts",
    "seed:smartaihub:docs": "tsx scripts/seed-doc-pages.ts",
    "seed:smartaihub:seo": "tsx scripts/seed-smartaihub-seo.ts",
    "seed:smartaihub:blog": "tsx scripts/seed-blog-posts.ts",
    "seed:smartaihub:content-factory": "tsx scripts/seed-smartaihub-content-factory.ts",
    "seed:smartaihub:content-import": "tsx scripts/seed-smartaihub-content-import.ts",
    "seed:smartaihub:auto-content": "tsx scripts/seed-smartaihub-auto-content.ts",
    "seed:smartaihub:intent-pages": "tsx scripts/seed-smartaihub-intent-pages.ts",
    "seed:smartaihub:extra": "tsx scripts/seed-extra-pages.ts",
    "backfill:credit-sources": "tsx scripts/backfill-credit-transaction-sources.ts",
    "backfill:library-knowledge": "node --import tsx scripts/backfill-library-knowledge.ts",
    "verify:library-knowledge": "node --import tsx scripts/verify-library-knowledge-migrations.ts",
    "verify:auto-team-work-request": "tsx scripts/verify-auto-team-work-request-readiness.ts",
    "debug:work-request-launch": "tsx scripts/debug-work-request-launch.ts",
    "repair:library-knowledge": "node --import tsx scripts/verify-library-knowledge-migrations.ts --repair-schema --repair-ledger",
    "repair:library-knowledge-schema": "node --import tsx scripts/verify-library-knowledge-migrations.ts --repair-schema",
    "repair:library-knowledge-ledger": "node --import tsx scripts/verify-library-knowledge-migrations.ts --repair-ledger",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
