{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-character-visual-bible/output",
  "title": "Character Visual Bible Output (upstream parity)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "visual_bible_summary",
    "characters",
    "plain_text_summary",
    "storyboard_attachment_manifest",
    "contract_version"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "visual_bible_summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "story_title": {
          "type": "string"
        },
        "overall_style": {
          "type": "string"
        },
        "consistency_strategy": {
          "type": "string"
        }
      },
      "required": [
        "story_title",
        "overall_style",
        "consistency_strategy"
      ]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "character_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "visual_identity_summary": {
            "type": "string"
          },
          "identity_anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signature_wardrobe": {
            "type": "string"
          },
          "hair_makeup_notes": {
            "type": "string"
          },
          "performance_energy": {
            "type": "string"
          },
          "primary_portrait_prompt": {
            "type": "string"
          },
          "full_body_prompt": {
            "type": "string"
          },
          "expression_sheet_prompt": {
            "type": "string"
          },
          "outfit_sheet_prompt": {
            "type": "string"
          },
          "turnaround_prompt": {
            "type": "string"
          },
          "negative_prompt": {
            "type": "string"
          },
          "attachment_package": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "asset_type": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "recommended_filename": {
                  "type": "string"
                }
              },
              "required": [
                "asset_type",
                "purpose",
                "recommended_filename"
              ]
            }
          }
        },
        "required": [
          "character_id",
          "name",
          "role",
          "visual_identity_summary",
          "identity_anchors",
          "signature_wardrobe",
          "hair_makeup_notes",
          "performance_energy",
          "primary_portrait_prompt",
          "full_body_prompt",
          "expression_sheet_prompt",
          "outfit_sheet_prompt",
          "turnaround_prompt",
          "negative_prompt",
          "attachment_package"
        ]
      }
    },
    "plain_text_summary": {
      "type": "string"
    },
    "storyboard_attachment_manifest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "handoff_type": {
          "const": "character_reference_package"
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "usage_note": {
          "type": "string"
        }
      },
      "required": [
        "handoff_type",
        "characters",
        "usage_note"
      ]
    }
  }
}
