{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-character-look-designer/input",
  "title": "Vertical Drama Character Look Design Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "locale", "series_context", "characters", "requests"],
  "properties": {
    "contract_version": { "const": 1 },
    "locale": { "type": "string", "enum": ["th", "en"] },
    "series_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genre", "tone", "visual_culture"],
      "properties": {
        "genre": { "type": "string", "maxLength": 240 },
        "tone": { "type": "string", "maxLength": 240 },
        "visual_culture": { "type": "string", "maxLength": 500 },
        "palette": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 160 } },
        "realism": { "type": "string", "maxLength": 160 }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_key", "name", "identity_facts"],
        "properties": {
          "character_key": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role": { "type": "string", "maxLength": 240 },
          "occupation": { "type": "string", "maxLength": 240 },
          "identity_facts": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "existing_look_facts": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } }
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_key", "parent_character_key", "variant_label", "variant_type", "canonical_intent", "evidence"],
        "allOf": [
          {
            "if": { "properties": { "variant_type": { "const": "age_stage" } } },
            "then": { "required": ["age_stage"] }
          },
          {
            "if": { "properties": { "variant_type": { "const": "outfit" } } },
            "then": { "not": { "required": ["age_stage"] } }
          }
        ],
        "properties": {
          "request_key": { "type": "string", "minLength": 1, "maxLength": 500 },
          "parent_character_key": { "type": "string", "minLength": 1, "maxLength": 160 },
          "variant_label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "variant_type": { "type": "string", "enum": ["outfit", "age_stage"] },
          "age_stage": { "type": "string", "enum": ["infant", "early_childhood", "school_age", "university_student", "adult", "older_adult"] },
          "canonical_intent": { "type": "string", "minLength": 1, "maxLength": 160 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shot_number", "text"],
              "properties": {
                "shot_number": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "minLength": 1, "maxLength": 700 },
                "scene_key": { "type": "string", "maxLength": 160 },
                "location_key": { "type": "string", "maxLength": 160 },
                "time_key": { "type": "string", "maxLength": 160 }
              }
            }
          }
        }
      }
    }
  }
}
