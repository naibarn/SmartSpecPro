{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-series-memory-planner/input",
  "title": "Series Memory Planner Input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "series_id"
  ],
  "properties": {
    "series_id": {
      "type": "string"
    },
    "current_episode_number": {
      "type": "integer",
      "minimum": 1
    },
    "prior_memory": {
      "type": "object",
      "additionalProperties": true
    },
    "current_episode_script": {
      "type": "object",
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "max_memory_tokens": {
      "type": "integer"
    }
  }
}
