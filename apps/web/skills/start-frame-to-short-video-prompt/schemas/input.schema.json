{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide Start-Frame Video Prompt Input",
  "description": "Input for generating a single text-only video prompt from one slide image start frame.",
  "type": "object",
  "additionalProperties": false,
  "required": ["start_frame_image", "output_language"],
  "properties": {
    "start_frame_image": {
      "title": "Start frame image",
      "description": "Drag and drop one slide image to use as the first frame for image-to-video generation.",
      "type": "string",
      "format": "uri",
      "contentMediaType": "image/*",
      "x-ui-widget": "file",
      "x-ui-file-accept": "image/*",
      "x-ui-file-mode": "drag-and-drop",
      "x-ui-max-files": 1
    },
    "output_language": {
      "title": "Prompt language",
      "description": "Language used for the generated prompt text.",
      "type": "string",
      "default": "th",
      "enum": [
        "th",
        "en",
        "ja",
        "ko",
        "zh-Hans",
        "zh-Hant",
        "es",
        "fr",
        "de",
        "it",
        "pt",
        "ru",
        "ar",
        "hi",
        "id",
        "vi",
        "ms",
        "tl",
        "custom"
      ],
      "enumNames": [
        "ไทย",
        "English",
        "日本語",
        "한국어",
        "简体中文",
        "繁體中文",
        "Español",
        "Français",
        "Deutsch",
        "Italiano",
        "Português",
        "Русский",
        "العربية",
        "हिन्दी",
        "Bahasa Indonesia",
        "Tiếng Việt",
        "Bahasa Melayu",
        "Filipino / Tagalog",
        "Custom language"
      ]
    },
    "custom_language_label": {
      "title": "Custom language",
      "description": "Use this only when Prompt language is set to Custom language.",
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "output_language": {
            "const": "custom"
          }
        },
        "required": ["output_language"]
      },
      "then": {
        "required": ["custom_language_label"]
      }
    }
  ]
}
