  "product_category": {
    "ui:widget": "select"
  },
  "custom_product_category": {
    "ui:widget": "text"
  },
  "product_name": {
    "ui:widget": "text",
    "ui:placeholder": "e.g. minimalist coffee table"
  },
  "product_mark_name": {
    "ui:widget": "text",
    "ui:placeholder": "Optional internal name; removed from output"
  },
  "brand_name": {
    "ui:widget": "text",
    "ui:placeholder": "Legacy internal name; removed from output"
  },
  "product_reference_images": {
    "ui:widget": "image-uploader",
    "ui:options": {
      "accept": [
        "image/*"
      ],
      "multiple": true,
      "maxItems": 4,
      "minItems": 1,
      "display": "grid",
      "enableDragAndDrop": true
    }
  },
  "character_images": {
    "ui:widget": "image-uploader",
    "ui:options": {
      "accept": [
        "image/*"
      ],
      "multiple": true,
      "maxItems": 4,
      "display": "grid",
      "enableDragAndDrop": true
    }
  },
  "supporting_images": {
    "ui:widget": "image-uploader",
    "ui:options": {
      "accept": [
        "image/*"
      ],
      "multiple": true,
      "maxItems": 4,
      "display": "grid",
      "enableDragAndDrop": true
    }
  },
  "clip_direction": {
    "ui:widget": "select"
  },
  "custom_clip_direction": {
    "ui:widget": "textarea",
    "ui:options": {
      "rows": 3
    }
  },
  "story_structure": {
    "ui:widget": "select"
  },
