{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vertical Drama Season Carry-Over Planner Output",
  "description": "Documentation copy of server/services/verticalDramaSeasonCarryOver.ts's seasonCarryOverLlmDraftSchema (zod is the enforced source of truth; this file is not read by the service).",
  "type": "object",
  "required": [
    "contract_version",
    "characters",
    "newConflictDirections",
    "antagonistStrategy"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["characterKey", "name", "postFinaleStatus", "availability"],
        "properties": {
          "characterKey": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "postFinaleStatus": { "type": "string", "minLength": 1 },
          "availability": {
            "type": "string",
            "enum": ["returns", "returns_with_explanation", "write_out", "cameo_only"]
          },
          "returnJustification": { "type": "string" },
          "suggestedStateUpdate": { "type": "string" }
        }
      }
    },
    "newCharacterSuggestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "newConflictDirections": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "antagonistStrategy": { "type": "string", "minLength": 1 }
  }
}
