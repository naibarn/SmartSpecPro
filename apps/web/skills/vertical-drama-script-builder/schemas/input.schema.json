{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-script-builder/input",
  "title": "Vertical Drama Script Builder Input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "story_title",
    "story_brief"
  ],
  "properties": {
    "locale": {
      "type": "string",
      "enum": [
        "th",
        "en"
      ]
    },
    "dialogue_language_profile": {
      "description": "Optional shared spoken-language/market contract. Missing legacy data resolves to Auto.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "spokenLocale": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit spoken language/market id from the shared Vertical Drama spoken-locale registry; auto is allowed."
        },
        "marketMode": {
          "type": "string",
          "enum": [
            "auto",
            "american",
            "british",
            "australian",
            "international"
          ]
        },
        "resolvedSpokenLocale": {
          "type": "string",
          "minLength": 1
        },
        "resolutionReason": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "story_title": {
      "type": "string"
    },
    "story_brief": {
      "type": "string"
    },
    "duration_seconds": {
      "const": 60
    },
    "episode_number": {
      "type": "integer",
      "minimum": 1
    },
    "episode_count": {
      "type": "integer",
      "minimum": 1
    },
    "season_arc": {
      "type": "string"
    },
    "genre": {
      "description": "Optional free-text genre fact (planning/vertical-drama-retention-hooks/plan.md W1, added 2026-07-11) — the series' own `genre` column (varchar, NOT a fixed enum; may be Thai/English/mixed, e.g. 'romance', 'educational', 'ดราม่า'). Only rendered when the retention-hooks flag is on. skill.md's 'Retention loop by genre' section maps this to the closest behavior group using judgment, not an exact match.",
      "type": "string"
    },
    "recent_retention_loop_types": {
      "description": "Optional list of the `retention_loop.type` values used by the last few episodes (planning/vertical-drama-retention-hooks/plan.md W5, added 2026-07-11) — lets the model avoid repeating the same retention-loop type. Populated by a later pipeline round; only rendered when the retention-hooks flag is on and this array is non-empty.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "new_question",
          "unresolved_image",
          "clue",
          "threat",
          "promise",
          "emotional_turn"
        ]
      }
    },
    "prior_episode_recap": {
      "type": "string"
    },
    "memory_state": {
      "type": "object",
      "additionalProperties": true
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "character_id",
          "name",
          "role"
        ],
        "additionalProperties": true,
        "properties": {
          "character_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "relationship_state": {
            "type": "string"
          }
        }
      }
    },
    "product_tie_in_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "age_control": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_age_group": {
          "type": "string"
        },
        "target_rating": {
          "type": "string"
        }
      }
    },
    "speech_budget": {
      "description": "Optional episode speech-budget target from the platform's canonical speech-budget module (added 2026-07-07, story-density reform). When present, structure.beats must carry dialogue-complete dialogue_lines[] sized to this budget — see skill.md 'Speech budget'.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "target_speech_seconds_min": {
          "type": "number"
        },
        "target_speech_seconds_max": {
          "type": "number"
        },
        "per_shot_band": {
          "description": "Target/minimum speech seconds for each distinct clip-duration band in the episode's duration profile (e.g. the main ~8s shots vs. a trailing ~4s shot).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "clip_duration_seconds": {
                "type": "number"
              },
              "target_speech_seconds": {
                "type": "number"
              },
              "min_speech_seconds": {
                "type": "number"
              }
            }
          }
        },
        "locale": {
          "type": "string"
        }
      }
    },
    "content_budget": {
      "description": "Optional per-episode content budget carried by the active series-bible breakdown item (VerticalDramaEpisodeContentBudget, added 2026-07-07, story-density reform) — states how much narrative material this episode was conceived to carry.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "beatCount": {
          "type": "integer",
          "minimum": 1
        },
        "estimatedSpeechSeconds": {
          "type": "number"
        },
        "conflictLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "reversalTarget": {
          "type": "integer",
          "minimum": 0
        },
        "arcThreads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "episode_draft": {
      "description": "Optional deep-story-drafts refine base (W10-B, added 2026-07-08): a vetted, already-approved per-shot draft carried over from the season-planning stage. When present, REFINE it into the full script schema instead of generating from the story brief alone — see skill.md 'Episode draft (refine mode)'.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "shot_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "summary": {
                "type": "string"
              },
              "dialogue_lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "line": {
                      "type": "string"
                    },
                    "delivery": {
                      "type": "string"
                    }
                  }
                }
              },
              "silence_intent": {
                "type": "string",
                "enum": [
                  "dramatic_pause",
                  "action_visual",
                  "montage",
                  "establishing"
                ]
              }
            }
          }
        },
        "cliffhanger_line": {
          "type": "string"
        }
      }
    }
  }
}
