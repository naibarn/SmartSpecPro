{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-script-builder/output",
  "title": "Vertical Drama Script Builder Output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "episode_title",
    "hook",
    "structure",
    "scene_dialogue_summary",
    "cliffhanger",
    "character_state_deltas",
    "product_tie_in_plan",
    "continuity_notes",
    "warnings",
    "repair_queue",
    "contract_version"
  ],
  "properties": {
    "episode_title": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "structure": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "three_act",
            "beat"
          ]
        },
        "acts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "power_shift": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "holder_before": {
                    "type": "string"
                  },
                  "holder_after": {
                    "type": "string"
                  },
                  "how": {
                    "type": "string"
                  }
                }
              },
              "is_reversal": {
                "type": "boolean"
              },
              "intensity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "dialogue_lines": {
                "description": "Optional superset (added 2026-07-07, story-density reform): dialogue-complete lines authored for this beat, sized to the episode's speech_budget by the canonical estimator. See skill.md 'Speech budget'. Downstream dialogue_audio_plan distributes/enriches these lines rather than inventing new ones.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "speaker",
                    "line"
                  ],
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "line": {
                      "type": "string"
                    },
                    "delivery": {
                      "type": "string"
                    },
                    "subtext": {
                      "type": "string"
                    },
                    "estimated_speech_seconds": {
                      "type": "number"
                    }
                  }
                }
              },
              "estimated_speech_seconds": {
                "description": "Optional superset: beat-level total estimated speech seconds (sum of this beat's dialogue_lines[].estimated_speech_seconds), computed via the canonical speech estimator.",
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "character_emotional_arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "character_id": {
            "type": "string"
          },
          "start_emotion": {
            "type": "string"
          },
          "turning_beat": {
            "type": "integer"
          },
          "end_emotion": {
            "type": "string"
          }
        }
      }
    },
    "scene_dialogue_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cliffhanger": {
      "type": "string"
    },
    "character_state_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "product_tie_in_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "continuity_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "repair_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "contract_version": {
      "const": 1
    }
  }
}
