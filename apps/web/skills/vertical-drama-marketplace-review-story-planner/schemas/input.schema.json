{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product",
    "productImages",
    "series",
    "characters",
    "variationSeed"
  ],
  "properties": {
    "product": {
      "type": "object"
    },
    "productImages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Visual references for the review subject; multiple images may show the same product, object, restaurant, or place from different angles."
    },
    "series": {
      "type": "object"
    },
    "characters": {
      "type": "array",
      "maxItems": 4
    },
    "customerJourney": {},
    "direction": {
      "type": "string"
    },
    "variationSeed": {
      "type": "string"
    },
    "reviewSubjectType": {
      "type": "string",
      "default": "product",
      "enum": [
        "product",
        "object",
        "restaurant",
        "place",
        "tourist_attraction",
        "documentary",
        "app",
        "software",
        "work_system"
      ],
      "description": "Type of subject being reviewed or covered."
    }
  }
}
