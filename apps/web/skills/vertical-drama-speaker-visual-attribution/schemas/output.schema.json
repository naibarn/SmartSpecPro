{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-speaker-visual-attribution/output",
  "title": "Vertical Drama Speaker Attribution Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["speakers"],
  "properties": {
    "speakers": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker_label", "candidates"],
        "properties": {
          "speaker_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "person_id",
                "identity_confidence",
                "evidence"
              ],
              "properties": {
                "person_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "identity_confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence": { "type": "string", "maxLength": 240 }
              }
            }
          }
        }
      }
    }
  }
}
