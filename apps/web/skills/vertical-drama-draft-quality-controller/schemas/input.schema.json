{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "draft", "immutableConstraints"],
  "properties": {
    "mode": { "enum": ["evaluate", "revise"] },
    "draft": { "type": "object", "additionalProperties": true },
    "feedback": { "type": "object", "additionalProperties": true },
    "immutableConstraints": { "type": "object", "additionalProperties": true }
  }
}
