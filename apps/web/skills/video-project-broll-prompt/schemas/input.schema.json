{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "video-project-broll-prompt/input",
  "title": "Video Project B-roll Prompt Input",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "brief", "scene"],
  "properties": {
    "kind": { "type": "string", "enum": ["image", "video"] },
    "brief": { "type": "object" },
    "scene": { "type": "object" },
    "referenceImageUrl": { "type": ["string", "null"] },
    "userInstructions": { "type": ["string", "null"] }
  }
}
