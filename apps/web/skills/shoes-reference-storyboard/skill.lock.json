{
  "name": "shoes-reference-storyboard",
  "version": "1.0.0",
  "target_platform": "agents_python",
  "bundle_topology": "single-agent",
  "entrypoints": {
    "run": "scripts/run.sh",
    "verify": "scripts/verify.sh"
  },
  "outputs": [
    "SKILL.md",
    "skill.md",
    "schemas/input.schema.json",
    "schemas/ui.schema.json",
    "schemas/output.schema.json",
    "scripts/run.sh",
    "scripts/verify.sh",
    "references/input_contract.md",
    "references/output_contract.md",
    "references/maintenance.md",
    "MODEL_COMPATIBILITY.md"
  ],
  "supported_modes": [
    "create",
    "improve",
    "maintenance"
  ],
  "compatibility_mirror_policy": "mirror-skill-md",
  "subagent_manifest": null
}
