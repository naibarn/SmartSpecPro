{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartaihub.app/schemas/stages/breakdown.schema.json",
  "title": "Script Breakdown",
  "type": "object",
  "required": [
    "beats",
    "requiredAssets",
    "risks"
  ],
  "properties": {
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "beatId",
          "actions"
        ],
        "properties": {
          "beatId": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dialogueLineIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "requiredAssets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
