{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartaihub.app/schemas/stages/cast-resolution.schema.json",
  "title": "Cast Resolution",
  "type": "object",
  "required": [
    "characters",
    "warnings"
  ],
  "properties": {
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "characterId",
          "sourceAssetIds",
          "role"
        ],
        "properties": {
          "characterId": {
            "type": "string",
            "minLength": 1
          },
          "sourceAssetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          },
          "speakerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
