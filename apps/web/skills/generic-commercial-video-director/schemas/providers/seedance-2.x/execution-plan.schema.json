{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartaihub.app/schemas/providers/seedance-2.x/execution-plan.schema.json",
  "title": "Seedance 2.x Execution Plan",
  "type": "object",
  "required": [
    "model",
    "mode",
    "durationSeconds",
    "resolution",
    "ratio",
    "referencePlan",
    "prompt",
    "generationPayload",
    "preProcessing",
    "postGeneration",
    "qcRequirements",
    "warnings"
  ],
  "properties": {
    "model": {
      "type": "string",
      "enum": [
        "dreamina-seedance-2-0-260128",
        "dreamina-seedance-2-5-260628"
      ]
    },
    "mode": {
      "type": "string"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 4,
      "maximum": 30
    },
    "resolution": {
      "type": "string",
      "enum": [
        "480p",
        "720p",
        "1080p",
        "4k"
      ]
    },
    "ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16",
        "21:9",
        "adaptive"
      ]
    },
    "referencePlan": {
      "$ref": "https://smartaihub.app/schemas/providers/seedance-2.x/reference-plan.schema.json"
    },
    "prompt": {
      "$ref": "https://smartaihub.app/schemas/providers/seedance-2.x/prompt.schema.json"
    },
    "generationPayload": {
      "type": "object"
    },
    "preProcessing": {
      "type": "object"
    },
    "postGeneration": {
      "type": "object"
    },
    "qcRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
