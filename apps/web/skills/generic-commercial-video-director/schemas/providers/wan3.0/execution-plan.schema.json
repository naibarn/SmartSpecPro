{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartaihub.app/schemas/providers/wan3.0/execution-plan.schema.json",
  "title": "Wan 3.0 Execution Plan",
  "type": "object",
  "required": [
    "model",
    "mode",
    "durationSeconds",
    "resolution",
    "ratio",
    "referencePlan",
    "prompt",
    "generationPayload",
    "postGeneration",
    "qcRequirements",
    "warnings"
  ],
  "properties": {
    "model": {
      "type": "string",
      "enum": [
        "wan3.0-video",
        "wan3.0-video-prime"
      ]
    },
    "mode": {
      "type": "string"
    },
    "durationSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 2,
      "maximum": 30
    },
    "resolution": {
      "type": "string",
      "enum": [
        "480P",
        "720P",
        "1080P"
      ]
    },
    "ratio": {
      "type": "string",
      "enum": [
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16",
        "adaptive"
      ]
    },
    "referencePlan": {
      "$ref": "https://smartaihub.app/schemas/providers/wan3.0/reference-plan.schema.json"
    },
    "prompt": {
      "$ref": "https://smartaihub.app/schemas/providers/wan3.0/prompt.schema.json"
    },
    "generationPayload": {
      "type": "object"
    },
    "postGeneration": {
      "type": "object"
    },
    "qcRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
