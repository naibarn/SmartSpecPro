{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartaihub.app/schemas/providers/flux-3-video/execution-plan.schema.json",
  "title": "FLUX 3 Video Execution Plan",
  "type": "object",
  "required": [
    "model",
    "mode",
    "durationSeconds",
    "resolution",
    "aspectRatio",
    "keyframePlan",
    "prompt",
    "generationPayload",
    "draftStrategy",
    "postGeneration",
    "qcRequirements",
    "warnings"
  ],
  "properties": {
    "model": {
      "const": "flux-3-video"
    },
    "mode": {
      "type": "string",
      "enum": [
        "t2v",
        "i2v",
        "v2v",
        "draft_enhance"
      ]
    },
    "durationSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 5,
      "maximum": 20
    },
    "resolution": {
      "type": "string",
      "enum": [
        "hd",
        "fhd"
      ]
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "auto",
        "21:9",
        "2:1",
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16"
      ]
    },
    "keyframePlan": {
      "$ref": "https://smartaihub.app/schemas/providers/flux-3-video/keyframe-plan.schema.json"
    },
    "prompt": {
      "$ref": "https://smartaihub.app/schemas/providers/flux-3-video/prompt.schema.json"
    },
    "generationPayload": {
      "type": "object"
    },
    "draftStrategy": {
      "type": "object"
    },
    "postGeneration": {
      "type": "object"
    },
    "qcRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
