{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-dialogue-audio-planner/output",
  "title": "Vertical Drama Dialogue & Audio Planner Output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "dialogue_lines",
    "speaker_mapping",
    "voice_continuity_map",
    "missing_voice_warnings",
    "subtitle_cues",
    "audio_timing_estimate",
    "native_audio_snippets",
    "separate_tts_plan",
    "warnings",
    "repair_queue",
    "contract_version"
  ],
  "properties": {
    "dialogue_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "speaker_character_id",
          "dialogue_line"
        ],
        "properties": {
          "shot_number": {
            "type": "integer"
          },
          "clip_number": {
            "type": "integer"
          },
          "speaker_character_id": {
            "type": "string"
          },
          "dialogue_line": {
            "type": "string"
          },
          "estimated_seconds": {
            "type": "number"
          },
          "delivery": {
            "description": "Per-line delivery direction (Phase 3B narrative-quality superset). See skill.md 'Per-line delivery direction'.",
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "tone": {
                "type": "string"
              },
              "pace": {
                "type": "string"
              },
              "pauses": {
                "type": "string"
              },
              "texture": {
                "type": "string"
              }
            }
          },
          "subtext": {
            "description": "What the character is really thinking/feeling underneath the literal words.",
            "type": "string"
          },
          "origin": {
            "description": "Optional superset (added 2026-07-07, story-density reform): traces where this line's text came from. 'script' = copied/distributed from a dialogue-complete script beat's dialogue_lines[] (the expected case). 'script_fallback' = the legacy path — no dialogue-complete beats were available, so this line was reconstructed from a freeform scene/dialogue summary or positional guesswork; this value always pairs with a matching entry in warnings. See skill.md 'HARD RULE — dialogue-complete script is the source of truth'.",
            "type": "string",
            "enum": [
              "script",
              "script_fallback"
            ]
          }
        }
      }
    },
    "speaker_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "voice_continuity_map": {
      "type": "object",
      "additionalProperties": true
    },
    "missing_voice_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "subtitle_cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "shot_number": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number"
          },
          "end_seconds": {
            "type": "number"
          },
          "safe_area_hint": {
            "type": "string"
          }
        }
      }
    },
    "audio_timing_estimate": {
      "type": "object",
      "additionalProperties": true
    },
    "native_audio_snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "separate_tts_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "repair_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "contract_version": {
      "const": 1
    }
  }
}
