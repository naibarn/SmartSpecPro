{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vertical-drama-storyboard-shotgrid/input",
  "title": "Storyboard Shotgrid Input (upstream parity)",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "story_source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "source_json",
            "source_text"
          ]
        },
        "drama_skill_json": {
          "type": "object",
          "additionalProperties": true
        },
        "plain_text_script": {
          "type": "string"
        },
        "episode_brief": {
          "type": "string"
        }
      }
    },
    "style_preset": {
      "type": "string",
      "enum": [
        "romantic_drama",
        "family_melodrama",
        "workplace_thriller",
        "luxury_melodrama",
        "custom"
      ]
    },
    "custom_style": {
      "type": "string"
    },
    "visual_style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "camera_feel": {
          "type": "string"
        },
        "color_mood": {
          "type": "string"
        },
        "cinematic_quality_target": {
          "type": "string",
          "enum": [
            "premium",
            "premium_vertical_cinema",
            "ultra_premium"
          ]
        }
      }
    },
    "workflow_level": {
      "type": "string",
      "enum": [
        "guided",
        "simple",
        "custom"
      ]
    },
    "narrative_goal": {
      "type": "string",
      "enum": [
        "plot_first",
        "emotion_first",
        "reveal_first",
        "balanced"
      ]
    },
    "shot_planning": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "shots_per_minute": {
          "type": "number"
        },
        "minimum_visual_variety": {
          "type": "boolean"
        },
        "target_shot_mix": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "establishing",
              "wide",
              "medium",
              "half_body",
              "close_up",
              "extreme_close_up",
              "over_the_shoulder",
              "insert",
              "reaction"
            ]
          }
        }
      }
    },
    "view_type": {
      "type": "string",
      "enum": [
        "establishing",
        "wide",
        "medium",
        "half_body",
        "close_up",
        "extreme_close_up",
        "over_the_shoulder",
        "insert",
        "reaction"
      ]
    },
    "continuity_controls": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "identity_lock": {
          "type": "boolean"
        },
        "keep_face_consistent": {
          "type": "boolean"
        },
        "keep_hair_consistent": {
          "type": "boolean"
        },
        "keep_outfit_consistent": {
          "type": "boolean"
        },
        "preserve_character_positions": {
          "type": "boolean"
        },
        "preserve_emotional_progression": {
          "type": "boolean"
        },
        "preserve_lighting_logic": {
          "type": "boolean"
        },
        "preserve_props_continuity": {
          "type": "boolean"
        },
        "must_preserve_story_beats": {
          "type": "boolean"
        },
        "allow_episode_specific_outfit_change": {
          "type": "boolean"
        },
        "carry_forward_from_previous_episode": {
          "type": "boolean"
        },
        "previous_episode_visual_notes": {
          "type": "string"
        }
      }
    },
    "output_options": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "include_3x3_contact_sheet_instruction": {
          "type": "boolean"
        },
        "include_image_generation_prompts": {
          "type": "boolean"
        },
        "include_json_handoff": {
          "type": "boolean"
        },
        "include_negative_prompts": {
          "type": "boolean"
        },
        "include_plain_text_storyboard": {
          "type": "boolean"
        }
      }
    },
    "character_reference_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "ref_label": {
            "type": "string"
          },
          "ref_source": {
            "type": "string"
          }
        }
      }
    },
    "target_age_group": {
      "type": "string",
      "enum": [
        "preschool",
        "tweens",
        "young_adults",
        "adults",
        "family_all",
        "teens"
      ]
    },
    "target_rating": {
      "type": "string"
    },
    "age_control": {
      "type": "object",
      "additionalProperties": true
    },
    "app_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "characters": {
      "description": "App-side character roster — NOT part of the imported upstream contract; rendered into the free-text prompt by verticalDramaStoryboardGeneration.ts's buildUserPrompt, one entry per BASE character (documented here for parity with GenerateStoryboardShotgridParams.characters, planning/vertical-drama-character-variants/plan.md Phase D).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "characterId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "referenceImageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "variants": {
            "description": "This base character's available outfit/age-stage 'looks' (Phase A/B variant rows: same person, different characterKey, own approved portrait), supplied as input facts only — the skill picks whichever variant's description best matches a shot's own scene and emits THAT variant's characterKey in the shot's characters/required_character_refs instead of the base character's. Empty/absent for a character with no variant rows (unchanged legacy behavior). See skill.md 'Character variant selection'.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "characterKey",
                "variantLabel",
                "variantType",
                "description",
                "referenceImageUrl"
              ],
              "properties": {
                "characterKey": {
                  "type": "string"
                },
                "variantLabel": {
                  "type": "string"
                },
                "variantType": {
                  "type": "string",
                  "enum": [
                    "outfit",
                    "age_stage"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "referenceImageUrl": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "episode_draft": {
      "description": "Optional deep-story-drafts refine base (W10-B, added 2026-07-08): the same vetted per-shot draft carried over from the season-planning stage that the script-builder skill accepts. When present, REFINE it into the full storyboard shot schema — preserve the 9-shot allocation and shot_number alignment, pass through silence_intent — instead of building the 9 shots from the script/scene beats alone. See skill.md 'Episode draft (refine mode)'.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "shot_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "summary": {
                "type": "string"
              },
              "dialogue_lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "speaker": {
                      "type": "string"
                    },
                    "line": {
                      "type": "string"
                    },
                    "delivery": {
                      "type": "string"
                    }
                  }
                }
              },
              "silence_intent": {
                "type": "string",
                "enum": [
                  "dramatic_pause",
                  "action_visual",
                  "montage",
                  "establishing"
                ]
              }
            }
          }
        },
        "cliffhanger_line": {
          "type": "string"
        }
      }
    }
  }
}
