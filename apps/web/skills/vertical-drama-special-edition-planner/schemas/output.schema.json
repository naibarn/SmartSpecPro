{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vertical Drama Special Edition Planner Output",
  "description": "Documentation copy of the JSON shape skill.md's OUTPUT section teaches. No zod schema/service module consumes this skill yet (Stage 2.5, planning/vd-series-memory-and-lineage/plan.md, ships the skill.md craft + the productTieIn config builder; wiring an actual LLM call is a follow-up). This file documents intent only and is not read by any code.",
  "type": "object",
  "required": [
    "contractVersion",
    "storyShape",
    "premise",
    "charactersUsed",
    "episodeBriefs",
    "continuityNotes"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "storyShape": { "type": "string", "enum": ["review", "tie_in_solution"] },
    "premise": { "type": "string", "minLength": 1 },
    "charactersUsed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["characterKey", "roleInSpecial"],
        "properties": {
          "characterKey": { "type": "string", "minLength": 1 },
          "roleInSpecial": { "type": "string", "minLength": 1 }
        }
      }
    },
    "episodeBriefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["episodeNumber", "logline", "protagonistStake", "pricePaid"],
        "properties": {
          "episodeNumber": { "type": "integer", "minimum": 1 },
          "logline": { "type": "string", "minLength": 1 },
          "protagonistStake": { "type": "string", "minLength": 1 },
          "pricePaid": { "type": "string", "minLength": 1 }
        }
      }
    },
    "continuityNotes": { "type": "string", "minLength": 1 },
    "disclosureApproach": { "type": "string" }
  }
}
