{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "shots"],
  "properties": {
    "contract_version": { "const": "vd-shot-scene-intent-v1" },
    "shots": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["shot_number", "scene_intent"],
        "properties": {
          "shot_number": { "type": "integer", "minimum": 1, "maximum": 9 },
          "scene_intent": {
            "type": "object",
            "required": [
              "contract_version",
              "physical_character_refs",
              "screen_caller_refs",
              "offscreen_speaker_refs",
              "mentioned_only_refs",
              "supporting_presence",
              "communication_mode",
              "visual_plan",
              "dialogue_routing",
              "confidence",
              "needs_review",
              "reason_codes"
            ],
            "properties": {
              "contract_version": { "const": "vd-shot-scene-intent-v1" },
              "physical_character_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "screen_caller_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "offscreen_speaker_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "mentioned_only_refs": {
                "type": "array",
                "items": { "type": "string" }
              },
              "supporting_presence": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["role"],
                  "properties": {
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "count": { "type": "integer", "minimum": 1, "maximum": 20 },
                    "visibility": { "enum": ["visible", "background"] },
                    "action": { "type": "string", "maxLength": 500 }
                  },
                  "additionalProperties": true
                }
              },
              "communication_mode": {
                "enum": [
                  "none",
                  "phone_call",
                  "video_call",
                  "text_message",
                  "shout_through_barrier",
                  "barrier_dialogue",
                  "separate_locations",
                  "voice_only"
                ]
              },
              "visual_plan": {
                "type": "object",
                "required": [
                  "mode",
                  "reason_codes",
                  "primary_character_refs",
                  "secondary_character_refs"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "single_view",
                      "device_screen",
                      "dual_view",
                      "text_ui",
                      "voice_only",
                      "no_character"
                    ]
                  },
                  "reason_codes": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "primary_character_refs": {
                    "type": "array",
                    "maxItems": 10,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "secondary_character_refs": {
                    "type": "array",
                    "maxItems": 10,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "primary_location_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "secondary_location_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "additionalProperties": true
              },
              "dialogue_routing": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "required": [
                    "line_index",
                    "role",
                    "visual_target",
                    "must_be_on_screen",
                    "must_not_appear_physically"
                  ],
                  "properties": {
                    "line_index": { "type": "integer", "minimum": 0 },
                    "speaker_ref": { "type": "string", "minLength": 1 },
                    "role": {
                      "enum": [
                        "physical",
                        "screen_caller",
                        "offscreen",
                        "mentioned_only",
                        "unknown"
                      ]
                    },
                    "visual_target": {
                      "enum": ["body", "virtual_screen", "none", "text_ui"]
                    },
                    "must_be_on_screen": { "type": "boolean" },
                    "must_not_appear_physically": { "type": "boolean" }
                  },
                  "additionalProperties": true
                }
              },
              "confidence": { "enum": ["high", "medium", "low"] },
              "needs_review": { "type": "boolean" },
              "reason_codes": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
