{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/character-prompt-request.schema.json",
  "title": "Character Prompt Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["series_dna", "characters"],
  "properties": {
    "series_dna": { "$ref": "series-dna.schema.json" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "character-input.schema.json" }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images_per_character": { "type": "integer", "minimum": 1, "maximum": 100 },
        "face_diversity": { "type": "string", "enum": ["low", "medium", "high", "maximum"] },
        "presentation_variants": { "type": "integer", "minimum": 1, "maximum": 20 },
        "render_context": { "type": "string" }
      }
    }
  }
}
