{
  "dashboard": {
    "title": "Funnel Analytics - Performance & Metrics",
    "tags": ["funnel", "analytics", "smartspec"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Latency (p50, p95, p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(funnel_analytics_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} - p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(funnel_analytics_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} - p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(funnel_analytics_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}} - p99"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 2,
        "title": "Request Rate (req/sec)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(funnel_analytics_requests_total[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 3,
        "title": "Error Rate (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(funnel_analytics_errors_total[5m])) / sum(rate(funnel_analytics_requests_total[5m])) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Error Rate",
            "max": 100,
            "min": 0
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [5],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 4,
        "title": "Cache Hit Rate (%)",
        "type": "gauge",
        "targets": [
          {
            "expr": "sum(rate(funnel_analytics_cache_hits_total[5m])) / (sum(rate(funnel_analytics_cache_hits_total[5m])) + sum(rate(funnel_analytics_cache_misses_total[5m]))) * 100"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 50
                },
                {
                  "color": "green",
                  "value": 80
                }
              ]
            }
          }
        },
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 6,
          "h": 8
        }
      },
      {
        "id": 5,
        "title": "Status Code Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum(rate(funnel_analytics_requests_total[5m])) by (status_code)",
            "legendFormat": "{{status_code}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        },
        "gridPos": {
          "x": 18,
          "y": 8,
          "w": 6,
          "h": 8
        }
      },
      {
        "id": 6,
        "title": "Cache Performance by Endpoint",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(funnel_analytics_cache_hits_total[5m])",
            "legendFormat": "{{endpoint}} - hits"
          },
          {
            "expr": "rate(funnel_analytics_cache_misses_total[5m])",
            "legendFormat": "{{endpoint}} - misses"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Operations/sec"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 7,
        "title": "Error Breakdown by Type",
        "type": "table",
        "targets": [
          {
            "expr": "sum(increase(funnel_analytics_errors_total[1h])) by (endpoint, error_code)",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "indexByName": {},
              "renameByName": {
                "endpoint": "Endpoint",
                "error_code": "Error Code",
                "Value": "Count (1h)"
              }
            }
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 8,
        "title": "Request Count by Endpoint (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(funnel_analytics_requests_total[24h])) by (endpoint)",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "options": {
          "graphMode": "area",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 24,
          "h": 4
        }
      },
      {
        "id": 9,
        "title": "Slowest Endpoints (p99 latency)",
        "type": "bargauge",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(funnel_analytics_request_duration_seconds_bucket[5m])) by (le, endpoint))",
            "legendFormat": "{{endpoint}}"
          }
        ],
        "options": {
          "displayMode": "gradient",
          "orientation": "horizontal",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 1
                },
                {
                  "color": "red",
                  "value": 5
                }
              ]
            }
          }
        },
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 10,
        "title": "Node.js Process Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(smartspec_process_cpu_user_seconds_total[5m]) * 100",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "smartspec_nodejs_heap_size_used_bytes / 1024 / 1024",
            "legendFormat": "Heap Used (MB)"
          },
          {
            "expr": "smartspec_nodejs_eventloop_lag_seconds * 1000",
            "legendFormat": "Event Loop Lag (ms)"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Mixed Units"
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 28,
          "w": 12,
          "h": 8
        }
      }
    ]
  }
}
