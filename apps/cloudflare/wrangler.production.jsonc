{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "smartspec-cloudflare-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CLOUDFLARE_ACTIVATION": "disabled",
    "CLOUDFLARE_ENVIRONMENT": "production"
  },
  "kv_namespaces": [
    {
      "binding": "SEARCH_RESULT_CACHE",
      "id": "df6d9bead8644d0f8f334f59b6bdfbeb"
    }
  ],
  "routes": [
    {
      "pattern": "runtime.smartaihub.app",
      "custom_domain": true
    }
  ]
}
