{
  "manifest_version": 3,
  "name": "SmartAIHub Companion",
  "version": "0.1.142",
  "description": "Connect SmartAIHub capture, production, storyboard, drama, local AI, and supported browser workflows.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://shopee.co.th/*",
    "https://*.shopee.co.th/*",
    "https://www.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://*.tiktokglobalshop.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://smartaihub.app/*",
    "https://*.smartspec.pro/*",
    "https://*.smartaihub.app/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://flow.google/*",
    "https://*.flow.google/*",
    "https://*.google.com/*",
    "https://*.magnific.ai/*",
    "https://magnific.ai/*",
    "https://*.magnific.com/*",
    "https://magnific.com/*",
    "https://higgsfield.ai/*",
    "https://*.higgsfield.ai/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "assets/serviceWorker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://smartaihub.app/*",
      "https://*.smartaihub.app/*",
      "https://*.smartspec.pro/*"
    ]
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.co.th/*",
        "https://*.shopee.co.th/*",
        "https://www.tiktok.com/*",
        "https://shop.tiktok.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://flow.google/*",
        "https://*.flow.google/*",
        "https://*.google.com/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://www.tiktok.com/*",
        "https://*.magnific.ai/*",
        "https://magnific.ai/*",
        "https://*.magnific.com/*",
        "https://magnific.com/*",
        "https://higgsfield.ai/*",
        "https://*.higgsfield.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*"
      ],
      "js": [
        "assets/dragBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "SmartAIHub Companion"
  }
}
