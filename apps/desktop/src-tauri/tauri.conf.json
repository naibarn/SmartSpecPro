{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartSpec Pro",
  "version": "0.1.0",
  "identifier": "com.smartspec.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SmartSpec Pro",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; connect-src 'self' https://api.openrouter.ai https://*.anthropic.com https://*.openai.com https://*.deepseek.com https://generativelanguage.googleapis.com https://api.github.com wss://api.openrouter.ai wss://*.anthropic.com wss://*.openai.com wss://*.deepseek.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "python/**/*",
      "../sandbox-images/**/*"
    ],
    "externalBin": [],
    "windows": {
      "nsis": {
        "oneClick": false,
        "perMachine": true,
        "allowElevation": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": []
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": ["https://releases.smartspec.pro/{{target}}/{{arch}}/{{current_version}}"],
      "dialog": true,
      "pubkey": "GENERATE_WITH: cargo tauri signer generate -w ~/.tauri/smartspec.key"
    }
  }
}
