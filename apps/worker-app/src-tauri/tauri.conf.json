{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart AI Hub Worker App",
  "version": "0.1.218",
  "identifier": "com.smartaihub.worker-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart AI Hub Worker App",
        "width": 1040,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: http://localhost:*; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "resources": [
      "resources/comfy-mcp/manifest.json"
    ]
  }
}
