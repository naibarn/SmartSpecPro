# ============================================================================
# SECURITY - Prevent API keys and secrets from being committed
# ============================================================================

# Environment files with secrets
.env
.env.*
!.env.example
!.env.glitchtip.example
*.env
*.env.*
!.env.glitchtip.example

# Actual secret/credential FILES (not source code about secrets)
# Use specific file patterns — NOT wildcard *secret* which catches source code
credentials.json
secrets.json
config.secret.json
config.secret.*
*.credentials
*.secrets

# Private keys and certificates
*.pem
*.p12
*.pfx
*.ppk
id_rsa*

# Cloud provider credentials
.aws/
.gcp/
.azure/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/

# ============================================================================
# Node / JavaScript / TypeScript
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
dist/
build/
*.tsbuildinfo
.next/
out/
.nuxt
.cache
.parcel-cache

# ============================================================================
# IDEs and Editors
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================================
# Logs and temporary files
# ============================================================================
*.log
logs/
*.tmp
*.temp
.cache/

# ============================================================================
# Data and uploads (runtime data, not source code)
# ============================================================================
uploads/
downloads/
/media/
/public/media/
/static/media/
# Allow component media directories (design assets in source)
!apps/**/components/**/media/
!packages/**/components/**/media/

# ============================================================================
# Backups and data files
# ============================================================================
*.bak
*.backup
*.old
*.csv
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3
*_backup.sql
*backup*.sql

# ============================================================================
# OS-specific
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
*Zone.Identifier

# ============================================================================
# Coverage and testing
# ============================================================================
.coverage
.coverage.*
coverage/
htmlcov/
.pytest_cache/
.tox/

# Playwright transient output directories; committed evidence files remain tracked.
apps/web/test-results/production-director/*/

# ============================================================================
# Docker
# ============================================================================
docker-compose.override.yml
!docker/hermes.env.example
!docker/hermes.multi.env.example

# Local TLS material must be generated per environment.
nginx/ssl/*.key
nginx/ssl/*.pem
nginx/ssl/*.p12
nginx/ssl/*.pfx

# ============================================================================
# Compiled files
# ============================================================================
*.pyc
*.pyo
*.so
*.dll
*.exe
!apps/web/client/public/releases/smart-ai-hub-worker-app-*-x64-setup.exe
*.out
*.class

# ============================================================================
# SmartSpec-specific
# ============================================================================
.smartspec/cache/
.smartspec/temp/
checkpoints/
python-backend/celerybeat-schedule*
runs/
apps/web/skills/**/runs/
apps/web/debug/

# ============================================================================
# Database backups (auto-generated by Claude safety protocol)
# ============================================================================
.db-backups/

# ============================================================================
# Temporary workspaces (generated at runtime)
# ============================================================================
apps/web/tmp-workspace-*/

# ============================================================================
# FFmpeg sidecar binaries (downloaded separately, not committed)
# ============================================================================
apps/tauri-shell/binaries/ffmpeg-*
apps/tauri-shell/binaries/ffprobe-*

# ============================================================================
# Load testing (generated data, not committed)
# ============================================================================
load-tests/test-users.json
load-tests/test-users.jsonl
load-tests/metrics-*.json

# ============================================================================
# Orchestra runtime artifacts (session/archive data, not source code)
# ============================================================================
orchestra/archive/

# ============================================================================
# Local AI / build caches and large runtime artifacts (do not commit)
# ============================================================================
.turbo/
.codex
.codex/
default.profraw
apps/tauri-shell/default.profraw
apps/tauri-shell/binaries/.downloads/
apps/tauri-shell/binaries/litert-lm-*
apps/tauri-shell/resources/litert-lm-models/
apps/tauri-shell/src-tauri/binaries/ffmpeg-*
apps/tauri-shell/src-tauri/binaries/ffprobe-*
apps/tauri-shell/src-tauri/resources/litert-lm-models/
python-backend/media_storage/
python-backend/coverage.xml
apps/web/data/chat-memory-archives/
data/
coverage.xml
