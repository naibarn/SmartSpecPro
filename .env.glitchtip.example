# GlitchTip Configuration
# Copy to .env.glitchtip and fill in values, OR run ./scripts/setup-glitchtip.sh
# which generates this file automatically.
#
# IMPORTANT: Never commit .env.glitchtip — it contains the SECRET_KEY

# Required: Unique secret key
# Generate with: python3 -c "import secrets; print(secrets.token_hex(50))"
GLITCHTIP_SECRET_KEY=replace_with_generated_key

# Database (the 'glitchtip' DB must exist — setup script creates it)
DATABASE_URL=postgres://smartspec:YOUR_POSTGRES_PASSWORD@host.docker.internal:5432/glitchtip

# Redis (DB index 5 avoids conflicts with the app's Redis usage)
REDIS_URL=redis://host.docker.internal:6379/5

# Public domain used in email links and DSN URLs
GLITCHTIP_DOMAIN=https://glitchtip.smartaihub.app

# Container port (do not change)
PORT=8000

# Disable public self-registration
ENABLE_OPEN_USER_REGISTRATION=false

# Email notifications (optional)
# EMAIL_URL=smtp://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=glitchtip@smartaihub.app
