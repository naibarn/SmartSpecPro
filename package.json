{
  "name": "smartspec-pro",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev:web": "turbo run dev --filter=@smartspec/web",
    "dev:desktop": "bash ./scripts/desktop-app.sh dev",
    "build:desktop": "bash ./scripts/desktop-app.sh build",
    "build:desktop:local": "node ./scripts/desktop-build-local.mjs",
    "build:desktop:windows-local": "node ./scripts/desktop-build-local.mjs --target x86_64-pc-windows-msvc --bundle-mode on-demand",
    "desktop:info": "bash ./scripts/desktop-app.sh info",
    "release:desktop:gh": "node ./scripts/desktop-release-gh.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "turbo": "^2.5.0",
    "typescript": "^5.5.4",
    "vite-plugin-manus-runtime": "^0.0.57"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "d3-zoom": "^3.0.0",
    "posthog-js": "^1.347.2",
    "posthog-node": "^5.35.14",
    "reactflow": "^11.11.4",
    "rg": "^0.0.2",
    "sharp": "^0.34.5"
  }
}
