{
  "name": "smartspec-pro",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev:web": "turbo run dev --filter=@smartspec/web",
    "dev:desktop": "bash ./scripts/desktop-app.sh dev",
    "build:desktop": "bash ./scripts/desktop-app.sh build",
    "build:desktop:local": "node ./scripts/desktop-build-local.mjs",
    "build:desktop:windows-local": "node ./scripts/desktop-build-local.mjs --target x86_64-pc-windows-msvc --bundle-mode on-demand",
    "desktop:info": "bash ./scripts/desktop-app.sh info",
    "release:desktop:gh": "node ./scripts/desktop-release-gh.mjs",
    "release:remotion-executor": "npm --workspace @smartspec/remotion-executor run release:pack",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check:mcp146": "npm --workspace apps/web run check:mcp146",
    "security:mcp146": "npm --workspace apps/web run security:mcp146",
    "mcp:smoke": "npm --workspace apps/web run mcp:smoke",
    "mcp:failure-harness": "npm --workspace apps/web run mcp:failure-harness",
    "mcp:readiness": "npm --workspace apps/web run mcp:readiness",
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "turbo": "^2.5.0",
    "typescript": "^5.5.4",
    "vite-plugin-manus-runtime": "^0.0.57",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "d3-zoom": "^3.0.0",
    "posthog-js": "^1.347.2",
    "posthog-node": "^5.35.14",
    "reactflow": "^11.11.4",
    "rg": "^0.0.2",
    "sharp": "^0.35.3"
  },
  "version": "1.0.0",
  "astryx": {
    "theme": "@astryxdesign/theme-neutral"
  },
  "description": "[![CI](https://github.com/naibarn/SmartSpecPro/actions/workflows/ci.yml/badge.svg)](https://github.com/naibarn/SmartSpecPro/actions/workflows/ci.yml) [![License: MIT](https://img.shields.io/badge/License-MIT-yellow.svg)](./LICENSE) [![Release Stage](https://img.shields.io/badge/Release%20Stage-Alpha-orange)](#alpha-release-notice) [![Monorepo](https://img.shields.io/badge/Monorepo-Turbo-blue)](https://turbo.build/repo) [![Node](https://img.shields.io/badge/Node.js-20+-green)](https://nodejs.org/) [![Python](https://img.shields.io/badge/Python-3.11+-blue)](https://www.python.org/)",
  "main": "test_hash.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naibarn/SmartSpecPro.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/naibarn/SmartSpecPro/issues"
  },
  "homepage": "https://github.com/naibarn/SmartSpecPro#readme"
}
