{
  "version": 1,
  "targets": [
    {
      "name": "web",
      "env_files": [
        "apps/web/.env"
      ],
      "required": [
        {
          "variable": "DATABASE_URL"
        },
        {
          "variable": "JWT_SECRET",
          "min_length": 32
        },
        {
          "variable": "LLM_ENCRYPTION_KEY",
          "min_length": 32
        }
      ]
    },
    {
      "name": "python-backend",
      "env_files": [
        "python-backend/.env"
      ],
      "required": [
        {
          "variable": "DATABASE_URL"
        },
        {
          "variable": "SECRET_KEY",
          "min_length": 32
        },
        {
          "variable": "JWT_SECRET",
          "min_length": 32
        },
        {
          "variable": "ENCRYPTION_MASTER_KEY",
          "min_length": 32
        },
        {
          "variable": "ENVIRONMENT",
          "equals": "production"
        },
        {
          "variable": "DEBUG",
          "equals": "false"
        },
        {
          "variable": "LOG_LEVEL",
          "forbidden_values": [
            "DEBUG"
          ]
        }
      ],
      "checks": [
        {
          "variable": "STRIPE_SECRET_KEY",
          "forbidden_prefixes": [
            "sk_test_"
          ]
        },
        {
          "variable": "STRIPE_PUBLISHABLE_KEY",
          "forbidden_prefixes": [
            "pk_test_"
          ]
        }
      ]
    }
  ],
  "classifications": {
    "ui_managed": [
      "PGVECTOR_PASSWORD"
    ],
    "optional": [
      "OPENROUTER_API_KEY",
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "SMARTSPEC_INTERNAL_REINDEX_TOKEN",
      "MARKETPLACE_EXTENSION_ALLOWED_ORIGINS"
    ],
    "defaulted": [
      "MARKETPLACE_EXTENSION_TOKEN_TTL",
      "HYPERFRAMES_PLAYER_READY_TIMEOUT_MS",
      "HYPERFRAMES_PAGE_NAVIGATION_TIMEOUT_SEC",
      "HYPERFRAMES_CLI_RENDER_HARD_TIMEOUT_MS"
    ],
    "machine_local": [
      "HYPERFRAMES_RUNTIME_MODE",
      "HYPERFRAMES_OFFICIAL_RUNTIME_READY",
      "HYPERFRAMES_CLI_BINARY",
      "HYPERFRAMES_BROWSER_BINARY",
      "HYPERFRAMES_FFMPEG_BINARY",
      "HYPERFRAMES_FFPROBE_BINARY",
      "HYPERFRAMES_THAI_FONT_PATH"
    ],
    "deprecated": [
      "MARKETPLACE_HYPERFRAMES_RUNTIME_READY"
    ]
  }
}
