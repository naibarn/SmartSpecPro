{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Manifest Schema",
  "description": "Schema for validating AI skill workflow manifests",
  "type": "object",
  "required": ["name", "version", "description", "author", "nodes", "edges"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Skill name (unique identifier)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable description of the skill"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Author or organization name"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Skill tags for categorization"
    },
    "estimated_cost_credits": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated credit cost for executing this skill"
    },
    "max_execution_time_minutes": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum allowed execution time in minutes"
    },
    "inputs": {
      "type": "object",
      "description": "Expected input parameters for the skill"
    },
    "outputs": {
      "type": "object",
      "description": "Expected output parameters from the skill"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique node identifier"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Node type (tool name)"
          },
          "label": {
            "type": "string",
            "description": "Human-readable node label"
          },
          "config": {
            "type": "object",
            "description": "Node-specific configuration"
          },
          "inputs": {
            "type": "object",
            "description": "Input parameters for this node"
          },
          "outputs": {
            "type": "object",
            "description": "Output parameters from this node"
          }
        }
      },
      "description": "List of workflow nodes"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Source node ID"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "Target node ID"
          },
          "condition": {
            "type": "string",
            "description": "Optional condition for edge traversal"
          },
          "label": {
            "type": "string",
            "description": "Edge label"
          }
        }
      },
      "description": "List of edges connecting nodes"
    }
  }
}
