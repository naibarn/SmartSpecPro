        "evidence_sha": "ebb264aa0151e97e9e463b7d4ca23290a48569db",
        "final_state": "PARTIAL",
        "implementation_evidence": [
          "smartaihub-platform@ebb264aa0151e97e9e463b7d4ca23290a48569db"
        ],
        "implementation_status": "PARTIAL",
        "next_action": "Finish dependency isolation evidence after implementing the full Shell and Chat behavior; do not claim module stability from scaffolding.",
        "requirement_digest": "cb67953120f53072f24c4cf02a48684dbce0c51af34e8ebc4570d9ae5f71d2d4",
        "requirement_id": "REQ-C8D3AE2138BD",
        "requirement_text": "Migrate capabilities by bounded module, not by converting the whole Legacy application. Existing code, schemas, screens and UI assets are references only. Each new or reused module must document owner/provenance, permitted source inputs, data authority, capability manifest, tenant boundary, secret placement, target-specific release and rollback before enabling its route. No Legacy server import, worker process or shared all-powerful credential may become a hidden dependency of ordinary Cloudflare Core or Chat paths.",
        "source_spec_digest": "9776611ad8a6abf08546518ede17d55e03e438ca14e520f17e88cfe87adc11b4",
