# SmartSpec Pro - Development Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Keys (Optional - add your own if needed)
# ============================================
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_USER=smartspec
POSTGRES_PASSWORD=smartspec123
POSTGRES_DB=smartspec
DATABASE_URL=postgresql://smartspec:smartspec123@postgres:5432/smartspec

# ============================================
# Redis
# ============================================
REDIS_URL=redis://redis:6379

# Anonymous public Contact protection fallback.
# Preferred production setup is Admin Settings -> Contact Protection; these
# values remain supported for bootstrap/recovery when no UI values exist.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=smartaihub.app,www.smartaihub.app

# ============================================
# Security & Auth
# ============================================
JWT_SECRET=dev_jwt_secret_change_in_production_12345678
SECRET_KEY=dev_secret_key_change_in_production_87654321
SMARTSPEC_PROXY_TOKEN=dev_token_12345
SMARTSPEC_REINDEX_LOCALHOST_ONLY=1
SMARTSPEC_INTERNAL_REINDEX_TOKEN=
VECTORDB_PROVIDER=cloudflare_vectorize
VECTORDB_CURRENT_READ_PROVIDER=cloudflare_vectorize
VECTORDB_TARGET_PROVIDER=cloudflare_vectorize
VECTORDB_MIRROR_WRITES=false
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=smartspec
PGVECTOR_USER=smartspec
PGVECTOR_PASSWORD=
PGVECTOR_CONNECT_TIMEOUT=5
LIBRARY_PGVECTOR_SEARCH_TIMEOUT_MS=1500
LIBRARY_PGVECTOR_CANDIDATE_LIMIT=1000

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
PORT=3000

# ============================================
# CORS Settings
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8000

# ============================================
# Frontend URLs (for Vite)
# ============================================
VITE_API_URL=http://localhost:8000
VITE_CONTROL_PLANE_URL=http://localhost:7070
VITE_WS_URL=ws://localhost:8000

# ============================================
# OAuth Configuration
# ============================================
OAUTH_SERVER_URL=http://python-backend:8000

# ============================================
# Token Configuration
# ============================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# SmartAIHub Companion / Marketplace Capture
# ============================================
# Development can leave allowed origins empty; production must set exact
# chrome-extension://<extension-id> origins.
MARKETPLACE_CAPTURE_ENABLED=true
# Preferred product-level allowlist. The legacy variable remains supported.
COMPANION_EXTENSION_ALLOWED_ORIGINS=
MARKETPLACE_EXTENSION_ALLOWED_ORIGINS=
MARKETPLACE_EXTENSION_TOKEN_TTL=7d
MARKETPLACE_CAPTURE_MAX_UPLOAD_MB=10
MARKETPLACE_CAPTURE_LLM_ENABLED=false
MARKETPLACE_CAPTURE_LLM_MODEL=gpt-4.1-mini
MARKETPLACE_CAPTURE_LLM_GATEWAY_URL=http://127.0.0.1:3000

# ============================================
# HyperFrames Final Composite Runtime
# ============================================
# Keep readiness off until `npm --workspace @smartspec/web run hyperframes:doctor`
# reports `gate: official_runtime_ready` in the target worker image.
MARKETPLACE_HYPERFRAMES_RUNTIME_READY=false
HYPERFRAMES_RUNTIME_MODE=cli
HYPERFRAMES_OFFICIAL_RUNTIME_READY=0
HYPERFRAMES_CLI_BINARY=
HYPERFRAMES_BROWSER_BINARY=
HYPERFRAMES_FFMPEG_BINARY=
HYPERFRAMES_FFPROBE_BINARY=
HYPERFRAMES_THAI_FONT_PATH=
# Long-running final composite renders are background jobs; defaults scale up to
# 6 hours. Override only when the worker host needs a different budget.
HYPERFRAMES_PLAYER_READY_TIMEOUT_MS=
HYPERFRAMES_PAGE_NAVIGATION_TIMEOUT_SEC=
HYPERFRAMES_CLI_RENDER_HARD_TIMEOUT_MS=
