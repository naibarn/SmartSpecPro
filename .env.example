# SmartSpec Pro - Development Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Keys (Optional - add your own if needed)
# ============================================
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# Database Configuration
# ============================================
# PostgreSQL (for python-backend)
POSTGRES_USER=smartspec
POSTGRES_PASSWORD=smartspec_dev
POSTGRES_DB=smartspec
DATABASE_URL=postgresql://smartspec:smartspec_dev@postgres:5432/smartspec

# MySQL (for SmartSpecWeb)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smartspecweb
MYSQL_USER=smartspec
MYSQL_PASSWORD=smartspec123

# ============================================
# Redis
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Security & Auth
# ============================================
JWT_SECRET=dev_jwt_secret_change_in_production_12345678
SECRET_KEY=dev_secret_key_change_in_production_87654321
SMARTSPEC_PROXY_TOKEN=dev_token_12345

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
PORT=3000

# ============================================
# CORS Settings
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8000

# ============================================
# Frontend URLs (for Vite)
# ============================================
VITE_API_URL=http://localhost:8000
VITE_CONTROL_PLANE_URL=http://localhost:7070
VITE_WS_URL=ws://localhost:8000

# ============================================
# OAuth Configuration
# ============================================
OAUTH_SERVER_URL=http://python-backend:8000

# ============================================
# Token Configuration
# ============================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
