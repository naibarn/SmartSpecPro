[Unit]
Description=SmartSpecPro Web Application
Documentation=https://github.com/smartspecpro/smartspec
After=smartspec-backend.service
Requires=smartspec-backend.service
PartOf=smartspec.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/projects/SmartSpecPro/apps/web

# Environment
Environment="PATH=/home/dev/.nvm/versions/node/v24.13.0/bin:/usr/local/bin:/usr/bin:/bin"
Environment="NODE_ENV=production"
Environment="NODE_OPTIONS=--max-old-space-size=8192"
Environment="PORT=3000"
EnvironmentFile=-/home/dev/projects/SmartSpecPro/apps/web/.env

# Kill orphan on port, then wait until port is actually free (up to 10s)
ExecStartPre=/bin/bash -c '/usr/bin/fuser -k 3000/tcp 2>/dev/null || true'
ExecStartPre=/bin/bash -c 'for i in $(seq 1 20); do ss -tlnp 2>/dev/null | grep -q ":3000 " || exit 0; sleep 0.5; done; echo "WARN: port 3000 still in use after 10s"'

# Start directly via tsx (not npm run start — avoids extra parent process)
ExecStart=/home/dev/.nvm/versions/node/v24.13.0/bin/npx tsx server/_core/index.ts

# Clean shutdown: SIGTERM to main, then SIGKILL entire cgroup after 15s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15s

# Clean up port after stop
ExecStopPost=/bin/bash -c '/usr/bin/fuser -k 3000/tcp 2>/dev/null || true'

# Restart policy: only on failure, not on clean stop
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartspec-web

[Install]
WantedBy=smartspec.target
