[Unit]
Description=SmartSpecPro Python Backend
Documentation=https://github.com/smartspecpro/smartspec
After=docker.service smartspec-infra.service
Requires=smartspec-infra.service
PartOf=smartspec.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/projects/SmartSpecPro/python-backend

# Environment
Environment="PATH=/home/dev/projects/SmartSpecPro/python-backend/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/home/dev/projects/SmartSpecPro/python-backend/.env

# Kill orphan on port, then wait until port is actually free (up to 10s)
ExecStartPre=/bin/bash -c '/usr/bin/fuser -k 8000/tcp 2>/dev/null || true'
ExecStartPre=/bin/bash -c 'for i in $(seq 1 20); do ss -tlnp 2>/dev/null | grep -q ":8000 " || exit 0; sleep 0.5; done; echo "WARN: port 8000 still in use after 10s"'

# Start backend directly (no wrapper scripts)
ExecStart=/home/dev/projects/SmartSpecPro/python-backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

# Clean shutdown: SIGTERM to main, then SIGKILL entire cgroup after 15s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15s

# Clean up port after stop
ExecStopPost=/bin/bash -c '/usr/bin/fuser -k 8000/tcp 2>/dev/null || true'

# Restart policy: only on failure, not on clean stop
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartspec-backend

[Install]
WantedBy=smartspec.target
