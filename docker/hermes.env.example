# Hermes local runtime configuration for SmartSpec Pro
#
# Copy to docker/hermes.env and update the token before first run.

# Hermes image and command
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Local data directory for Hermes runtime state
HERMES_DATA_DIR=./data/hermes
HERMES_INSTANCE_NAME=smartspec-hermes

# Resource limits
HERMES_CPUS=2.0
HERMES_MEMORY=4G
HERMES_CPU_RESERVATION=0.5
HERMES_MEMORY_RESERVATION=512M
HERMES_SHM_SIZE=1g

# SmartSpec Pro gateway access
SMARTSPEC_USE_WEB_GATEWAY=1
SMARTSPEC_WEB_GATEWAY_URL=http://host.docker.internal:3000
SMARTSPEC_WEB_GATEWAY_TOKEN=
SMARTSPEC_MCP_BASE_URL=http://host.docker.internal:3000
SMARTSPEC_WEB_GATEWAY_TIMEOUT_SECONDS=600
SMARTSPEC_WEB_GATEWAY_RETRIES=2
GATEWAY_ALLOW_ALL_USERS=true
