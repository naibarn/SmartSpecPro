# Example configurations for running multiple Hermes agents side-by-side.
#
# Copy this file to separate per-instance env files, or use it as a reference
# when creating docker/hermes-a.env and docker/hermes-b.env.

# ---------------------------
# Hermes instance A
# ---------------------------
HERMES_PROJECT_NAME=smartspec-hermes-a
HERMES_DATA_DIR=./data/hermes-a
HERMES_INSTANCE_NAME=smartspec-hermes-a
SMARTSPEC_USE_WEB_GATEWAY=1
SMARTSPEC_WEB_GATEWAY_URL=http://host.docker.internal:3000
SMARTSPEC_WEB_GATEWAY_TOKEN=replace_me_gateway_or_signed_token
SMARTSPEC_MCP_BASE_URL=http://host.docker.internal:3000
SMARTSPEC_WEB_GATEWAY_TIMEOUT_SECONDS=600
SMARTSPEC_WEB_GATEWAY_RETRIES=2
GATEWAY_ALLOW_ALL_USERS=true

# ---------------------------
# Hermes instance B
# ---------------------------
# HERMES_PROJECT_NAME=smartspec-hermes-b
