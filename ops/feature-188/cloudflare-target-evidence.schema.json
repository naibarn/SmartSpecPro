{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloudflare target readiness evidence",
  "type": "object",
  "required": ["evidenceVersion", "accountIdentity", "releaseIdentity", "bindings", "hyperdrive", "deployment", "recovery", "vectorize", "evidenceRefs"],
  "properties": {
    "evidenceVersion": { "const": 1 },
    "accountIdentity": { "type": "string", "minLength": 1, "maxLength": 255, "description": "Redacted or externally stored identity; never a credential" },
    "releaseIdentity": { "type": "string", "minLength": 1, "maxLength": 255 },
    "bindings": {
      "type": "object",
      "required": ["HYPERDRIVE", "JOB_QUEUE", "JOB_WORKFLOW", "JOB_CONTAINERS", "WORKER_APP", "MEDIA_BUCKET", "VECTOR_INDEX"],
      "additionalProperties": { "const": true }
    },
    "hyperdrive": { "type": "object", "required": ["reachable", "cacheSafe", "poolCapacityVerified"], "properties": { "reachable": { "const": true }, "cacheSafe": { "const": true }, "poolCapacityVerified": { "const": true } }, "additionalProperties": true },
    "deployment": { "type": "object", "required": ["rollbackVerified", "restartVerified"], "properties": { "rollbackVerified": { "const": true }, "restartVerified": { "const": true } }, "additionalProperties": true },
    "recovery": { "type": "object", "required": ["providerRecoveryVerified", "pitrRestoreVerified"], "properties": { "providerRecoveryVerified": { "const": true }, "pitrRestoreVerified": { "const": true } }, "additionalProperties": true },
    "vectorize": {
      "type": "object",
      "required": ["sourceOfTruth", "embeddingModel", "dimensions", "metric", "workersAiVectorizeCredentialSeparationVerified", "tenantIsolationVerified", "rebuildVerified", "mutationRecoveryVerified", "embeddingParityVerified", "applicationVectorSourceInventoryVerified", "readPathParityVerified", "legacyVectorSourcesMigratedOrExplicitlyApproved", "sourceInventory", "indexes"],
      "properties": {
        "sourceOfTruth": { "const": "postgresql" },
        "embeddingModel": { "const": "@cf/baai/bge-base-en-v1.5" },
        "dimensions": { "const": 768 },
        "metric": { "const": "cosine" },
        "workersAiVectorizeCredentialSeparationVerified": { "const": true },
        "tenantIsolationVerified": { "const": true },
        "rebuildVerified": { "const": true },
        "mutationRecoveryVerified": { "const": true },
        "embeddingParityVerified": { "const": true },
        "applicationVectorSourceInventoryVerified": { "const": true },
        "readPathParityVerified": { "const": true },
        "legacyVectorSourcesMigratedOrExplicitlyApproved": { "const": true },
        "sourceInventory": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": ["name", "disposition"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "disposition": { "enum": ["migrated_to_vectorize", "legacy_explicitly_approved"] },
              "embeddingParityVerified": { "const": true },
              "readPathParityVerified": { "const": true },
              "privacyDeletionVerified": { "const": true },
              "rebuildCheckpointVerified": { "const": true },
              "approvalRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^(?!(?:approval://|todo(?:$|[:/_-])|tbd(?:$|[:/_-])|placeholder(?:$|[:/_-])|pending(?:$|[:/_-]))).+"
              }
            },
            "additionalProperties": true
          }
        },
        "indexes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["name", "dimensions", "metric", "metadataIndexes", "bindingVerified", "writeQueryDeleteVerified", "reindexCoverageVerified"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
              "dimensions": { "const": 768 },
              "metric": { "const": "cosine" },
              "metadataIndexes": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
              "bindingVerified": { "const": true },
              "writeQueryDeleteVerified": { "const": true },
              "reindexCoverageVerified": { "const": true }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 255 } }
  },
  "additionalProperties": false
}
