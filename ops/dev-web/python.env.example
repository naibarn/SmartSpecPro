ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://smartspec_dev_web:REPLACE_WITH_DEV_PASSWORD@127.0.0.1:5432/smartspec_dev_web
CHECKPOINT_DATABASE_URL=postgresql://smartspec_dev_web:REPLACE_WITH_DEV_PASSWORD@127.0.0.1:5432/smartspec_dev_web
REDIS_URL=redis://127.0.0.1:6391
JWT_SECRET=REPLACE_WITH_SAME_DEV_WEB_JWT_SECRET
SECRET_KEY=REPLACE_WITH_SAME_DEV_WEB_JWT_SECRET
LLM_ENCRYPTION_KEY=REPLACE_WITH_SAME_DEV_WEB_ENCRYPTION_KEY
ADMIN_EMAIL=dev-admin@aimarkethubs.com
SMARTSPEC_USE_WEB_GATEWAY=true
SMARTSPEC_WEB_GATEWAY_URL=http://127.0.0.1:3100
SMARTSPEC_WEB_GATEWAY_TOKEN=REPLACE_WITH_SHARED_DEV_ONLY_TOKEN
SMARTSPEC_PROXY_TOKEN=REPLACE_WITH_SHARED_DEV_ONLY_TOKEN
PYTHON_DOTENV_DISABLED=1

# To debug against the shared production database instead of the isolated DB:
# SMARTSPEC_DEV_DATABASE_MODE=shared-production
# SMARTSPEC_SHARED_DATABASE_NAME=smartspec
# DATABASE_URL=<existing production connection, kept in the private env file>
# Use the matching production encryption/auth keys for existing database values.
