[Unit]
Description=Cloudflare Tunnel for aimarkethubs.com development
After=network-online.target smartspec-dev-web.service
Wants=smartspec-dev-web.service

[Service]
ExecStart=/usr/bin/cloudflared --no-autoupdate --config %h/.config/smartspec-dev/cloudflared.yml tunnel run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
