{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"${DEEP_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_HOME:-$HOME/.codex}/skills/deep-plan}}/scripts/hooks/capture-session-id.py\"'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "deep-plan:section-writer",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"${DEEP_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_HOME:-$HOME/.codex}/skills/deep-plan}}/scripts/hooks/write-section-on-stop.py\"'"
          }
        ]
      }
    ]
  }
}
